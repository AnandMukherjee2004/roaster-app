generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TL
  ADMIN
  MANAGER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  role       Role
  teamLeadId String?
  joiningDate DateTime?
  empId       String?

  teamLead   User?    @relation("TLAgents", fields: [teamLeadId], references: [id])
  agents     User[]   @relation("TLAgents")

  markedAttendances AttendanceRecord[] @relation("MarkedBy")
  attendanceRecords AttendanceRecord[] @relation("AgentAttendance")

  auditsReceived AuditRecord[] @relation("AgentAudits")
  auditsGiven    AuditRecord[] @relation("AuditorAudits")

  createdAt  DateTime @default(now())
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  agentId    String
  markedById String
  date       DateTime         @db.Date
  status     AttendanceStatus
  createdAt  DateTime         @default(now())

  agent      User             @relation("AgentAttendance", fields: [agentId], references: [id])
  markedBy   User             @relation("MarkedBy", fields: [markedById], references: [id])

  @@unique([agentId, date])
}

model AuditRecord {
  id           String   @id @default(cuid())
  agentId      String
  auditorId    String
  customerName String
  leadId       String?
  callDate     DateTime @db.Date
  callDuration String?
  
  scores       Json     // Map of item key to { score: number, remark?: string }
  stepSubtotals Json    // Breakdown by step
  totalScore   Float    // Total score out of 100
  percentage   Float    // Overall percentage achieved
  rating       String   // e.g., Excellent, Good, Needs Improvement, Poor

  createdAt    DateTime @default(now())

  agent        User     @relation("AgentAudits", fields: [agentId], references: [id])
  auditor      User     @relation("AuditorAudits", fields: [auditorId], references: [id])
}
